rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can access only their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;

      // Each user can access only their own saves
      match /saves/{saveId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }
  }
}
