rules_version = '2';
// Prototype rules. Legacy /users and /users/{uid}/saves rules retained unchanged.
// weekendPlans/{20-char id}: title (1..80), ownerUid (1..128, immutable),
//   createdAt (server timestamp, immutable), optional deletingAt (server time, immutable).
// Deletion is irreversible: owner marks first, cleans scoped subcollections, then parent.
// members/{uid}: uid, role='editor', inviteToken (48 hex), joinedAt (immutable).
// invites/{48-hex token}: createdAt (immutable), expiresAt (max 8 days, immutable),
//   revoked (bool; only false -> true). Only owner lists tokens.
// spots/{known spot id}: weekend (Saturday 00:00 UTC timestamp, 'skip', or null),
//   'skip' means explicitly not attending this time; null clears the assignment.
//   revision (positive int <= 10M, increments exactly one), updatedBy, updatedAt.
// notes/{known spot id}: text (0..1000 Unicode codepoints; empty revisioned clear),
//   revision (1..10M, increments one), updatedBy (auth UID), updatedAt (server time).
// weekendPlanUsers/{uid}/plans/{planId}: title (1..80), joinedAt (server time).
// weekendPlanDeletions/{planId}: deletedAt server timestamp, permanent ID tombstone.
// No emails or display names are stored. No collection-group queries or global lists.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function uidUnchanged(uid) { return uid == request.auth.uid; }
    function uidNotModified(field) { return request.resource.data[field] == resource.data[field]; }
    function str(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function planExists(id) { return exists(/databases/$(database)/documents/weekendPlans/$(id)); }
    function planOwner(id) {
      return isAuthenticated() && planExists(id)
        && get(/databases/$(database)/documents/weekendPlans/$(id)).data.ownerUid == request.auth.uid;
    }
    function activePlan(id) {
      return planExists(id) && !('deletingAt' in get(/databases/$(database)/documents/weekendPlans/$(id)).data);
    }
    function activePlanAfter(id) {
      return !('deletingAt' in getAfter(/databases/$(database)/documents/weekendPlans/$(id)).data)
        && getAfter(/databases/$(database)/documents/weekendPlans/$(id)).data.ownerUid is string;
    }
    function deletingOwner(id) {
      return planOwner(id) && 'deletingAt' in get(/databases/$(database)/documents/weekendPlans/$(id)).data;
    }
    function member(id) {
      return isAuthenticated() && activePlan(id) &&
        (planOwner(id) || exists(/databases/$(database)/documents/weekendPlans/$(id)/members/$(request.auth.uid)));
    }
    function memberAfter(id) {
      return isAuthenticated() && activePlanAfter(id) &&
        (getAfter(/databases/$(database)/documents/weekendPlans/$(id)).data.ownerUid == request.auth.uid ||
         exists(/databases/$(database)/documents/weekendPlans/$(id)/members/$(request.auth.uid)));
    }
    function validPlan(d) {
      return d.keys().hasAll(['title','ownerUid','createdAt']) &&
        d.keys().hasOnly(['title','ownerUid','createdAt','deletingAt']) &&
        (!('deletingAt' in d) || d.deletingAt is timestamp) &&
        str(d.title,1,80) && str(d.ownerUid,1,128) && d.createdAt is timestamp;
    }
    function validInvite(d) {
      return d.keys().hasAll(['createdAt','expiresAt','revoked']) &&
        d.keys().hasOnly(['createdAt','expiresAt','revoked']) &&
        d.createdAt is timestamp && d.expiresAt is timestamp &&
        d.expiresAt > d.createdAt && d.expiresAt <= d.createdAt + duration.value(8,'d') &&
        d.revoked is bool;
    }
    function validMember(d) {
      return d.keys().hasAll(['uid','role','inviteToken','joinedAt']) &&
        d.keys().hasOnly(['uid','role','inviteToken','joinedAt']) &&
        str(d.uid,1,128) && d.role == 'editor' &&
        d.inviteToken is string && d.inviteToken.matches('^[a-f0-9]{48}$') && d.joinedAt is timestamp;
    }
    function validToken(id, token) {
      let invitation = get(/databases/$(database)/documents/weekendPlans/$(id)/invites/$(token)).data;
      return invitation.revoked == false && invitation.expiresAt > request.time;
    }
    function knownSpot(id) { return id in ["kenrokuen","kanazawa-castle","american-maple","shiko-park","honda-forest","gyokusenen","terashima","utatsuyama","metasequoia","natadera","murodo","midagahara","daikanbo","shomyo","bijodaira","kurobe-dam","kurobe-gorge","takaoka","shogawa","suganuma","ainokura","katsurako","arimine","miyajima","jinzu","folk-village","meditation","ropeway","kakusenkei","hakusan-road","hodatsusan","shiramine","white-road","tedori","aramata","oyama","tokyo-rikugien","tokyo-koishikawa","tokyo-furukawa","tokyo-hamarikyu","tokyo-shinjuku","tokyo-yoyogi","tokyo-gaien","tokyo-hibiya","tokyo-kiyosumi","tokyo-shibarikyu","tokyo-inokashira","tokyo-showa","tokyo-tonogayato","tokyo-jindai","tokyo-takao","tokyo-mitake","tokyo-akigawa","tokyo-okutama","tokyo-hakone-museum","tokyo-ashinoko","tokyo-engakuji","tokyo-meigetsuin","tokyo-nikko-shoyoen","tokyo-nagatoro","toyama-heiwa","toyama-baba","toyama-gofuku","toyama-jonichiji","toyama-sonkoji","toyama-choeiji","toyama-shosenji","toyama-jokoji","kanazawa-higashibetsuin","ishikawa-higashino-ginkgo","ishikawa-yamanobunkakan","ishikawa-sentsuji","ishikawa-ikage","ishikawa-yakuoin","tokyo-ueno","tokyo-hikarigaoka","tokyo-shiba","tokyo-kiba","tokyo-koganei","tokyo-johoku","tokyo-toyama-park","tokyo-koshu-ginkgo","tokyo-todai-hongo","tokyo-yasukuni","tokyo-gyoko","tokyo-kitanomaru","tokyo-yokohama-nihonodori","tokyo-yokohama-yamashita","tokyo-sankeien","tokyo-egara","tokyo-chichibu-muse","tokyo-tokorozawa-koku","tokyo-chiba-park","tokyo-sakura-castle","tokyo-sairenji","tokyo-bannaji","fuji-kawaguchiko-momiji-corridor","fuji-kawaguchiko-momiji-tunnel","fuji-asahigaoka","fuji-murayama-sengen","fuji-niihashi-sengen","karuizawa-usui-lookout"]; }
    function validAssignment(d) {
      return d.keys().hasAll(['weekend','revision','updatedBy','updatedAt']) &&
        d.keys().hasOnly(['weekend','revision','updatedBy','updatedAt']) &&
        (d.weekend == null || d.weekend == 'skip' || (d.weekend is timestamp &&
          d.weekend.toMillis() >= 1577836800000 && d.weekend.toMillis() < 4102444800000 &&
          d.weekend.toMillis() % 604800000 == 172800000)) &&
        d.revision is int && d.revision >= 1 && d.revision <= 10000000 &&
        str(d.updatedBy,1,128) && d.updatedBy == request.auth.uid &&
        d.updatedAt == request.time;
    }
    function validNote(d) {
      return d.keys().hasAll(['text','revision','updatedBy','updatedAt']) &&
        d.keys().hasOnly(['text','revision','updatedBy','updatedAt']) &&
        // RE2 enforces Unicode codepoints rather than storage length.
        d.text is string && d.text.size() <= 4000 && d.text.matches('(?s)^.{0,1000}$') &&
        d.revision is int && d.revision >= 1 && d.revision <= 10000000 &&
        str(d.updatedBy,1,128) && d.updatedBy == request.auth.uid &&
        d.updatedAt == request.time;
    }
    function validDeletion(d) {
      return d.keys().hasAll(['deletedAt']) && d.keys().hasOnly(['deletedAt']) && d.deletedAt == request.time;
    }
    function validIndex(d) {
      return d.keys().hasAll(['title','joinedAt']) && d.keys().hasOnly(['title','joinedAt']) &&
        str(d.title,1,80) && d.joinedAt is timestamp;
    }
    // Original profile/save scopes; no widening of existing access.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /saves/{saveId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /weekendPlans/{planId} {
      allow get: if member(planId) || deletingOwner(planId);
      allow list: if false;
      allow create: if isAuthenticated() && planId.matches('^[A-Za-z0-9]{20}$') &&
        !exists(/databases/$(database)/documents/weekendPlanDeletions/$(planId)) &&
        validPlan(request.resource.data) && !('deletingAt' in request.resource.data) && uidUnchanged(request.resource.data.ownerUid) &&
        request.resource.data.createdAt == request.time;
      allow update: if planOwner(planId) && validPlan(request.resource.data) &&
        uidNotModified('ownerUid') && request.resource.data.createdAt == resource.data.createdAt &&
        // Active title edits remain valid; deletion can only be started once.
        !('deletingAt' in resource.data) &&
        (!('deletingAt' in request.resource.data) ||
          (request.resource.data.deletingAt == request.time && request.resource.data.title == resource.data.title));
      allow delete: if deletingOwner(planId) &&
        getAfter(/databases/$(database)/documents/weekendPlanDeletions/$(planId)).data.deletedAt is timestamp;
      match /invites/{token} {
        // No PII; only a known high-entropy token may be fetched by a signed-in invitee.
        allow get: if isAuthenticated() && (activePlan(planId) || deletingOwner(planId)) && token.matches('^[a-f0-9]{48}$');
        allow list: if planOwner(planId);
        allow create: if planOwner(planId) && activePlanAfter(planId) && token.matches('^[a-f0-9]{48}$') &&
          validInvite(request.resource.data) && request.resource.data.createdAt == request.time &&
          request.resource.data.expiresAt > request.time && request.resource.data.revoked == false;
        allow update: if planOwner(planId) && activePlanAfter(planId) && validInvite(request.resource.data) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.expiresAt == resource.data.expiresAt &&
          resource.data.revoked == false && request.resource.data.revoked == true;
        allow delete: if deletingOwner(planId);
      }
      match /members/{uid} {
        allow get: if isAuthenticated() && ((activePlan(planId) && isOwner(uid)) || planOwner(planId));
        allow list: if planOwner(planId);
        allow create: if isOwner(uid) && activePlanAfter(planId) && validMember(request.resource.data) &&
          uidUnchanged(request.resource.data.uid) && request.resource.data.joinedAt == request.time &&
          validToken(planId,request.resource.data.inviteToken);
        allow update: if false;
        allow delete: if planOwner(planId) && (deletingOwner(planId) ||
          uid != get(/databases/$(database)/documents/weekendPlans/$(planId)).data.ownerUid);
      }
      match /notes/{spotId} {
        allow read: if member(planId) || deletingOwner(planId);
        allow create: if member(planId) && activePlanAfter(planId) && knownSpot(spotId) &&
          validNote(request.resource.data) && request.resource.data.revision == 1;
        allow update: if member(planId) && activePlanAfter(planId) && knownSpot(spotId) &&
          validNote(request.resource.data) && request.resource.data.revision == resource.data.revision + 1;
        // Empty notes retain conflict history until the whole plan is deleted.
        allow delete: if deletingOwner(planId);
      }
      match /spots/{spotId} {
        allow read: if member(planId) || deletingOwner(planId);
        allow create: if member(planId) && activePlanAfter(planId) && knownSpot(spotId) && validAssignment(request.resource.data) &&
          request.resource.data.revision == 1;
        allow update: if member(planId) && activePlanAfter(planId) && knownSpot(spotId) && validAssignment(request.resource.data) &&
          request.resource.data.revision == resource.data.revision + 1;
        // Active plans retain revisioned tombstones; only deletion cleanup removes them.
        allow delete: if deletingOwner(planId);
      }
    }
    // Permanent non-readable marker prevents reusing an ID to access orphaned data.
    match /weekendPlanDeletions/{planId} {
      allow read, update, delete: if false;
      allow create: if deletingOwner(planId) &&
        !existsAfter(/databases/$(database)/documents/weekendPlans/$(planId)) &&
        validDeletion(request.resource.data);
    }
    match /weekendPlanUsers/{uid}/plans/{planId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && memberAfter(planId) && validIndex(request.resource.data) &&
        request.resource.data.title == getAfter(/databases/$(database)/documents/weekendPlans/$(planId)).data.title &&
        request.resource.data.joinedAt == request.time;
      allow update: if false;
      allow delete: if isOwner(uid) || (deletingOwner(planId) &&
        exists(/databases/$(database)/documents/weekendPlans/$(planId)/members/$(uid)));
    }
  }
}
